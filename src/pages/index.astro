---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Header from "../components/Header.astro";
import MediaGallery from "../components/MediaGallery.astro";
import Testimonials from "../components/Testimonials.astro";
import Link from "../components/Link.astro";
import Footer from "../components/Footer.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import UiIcon from "../components/UiIcon.astro";

import { ADDRESS, HOURS, MAPS_EMBED_URL, MAPS_URL, TAGLINE, WHATSAPP_URL } from "../config";
import { FAQ } from "../data/faq";
import { homeSchema } from "../data/schema";
import { SERVICES } from "../data/services";

const links = await Astro.glob("../data/links/*.md");

const trust = [
	{ icon: "academic", label: "Formado pela UFU" },
	{ icon: "check", label: "Atendimento particular" },
	{ icon: "check", label: "Gympass – plano Silver" },
	{ icon: "pin", label: "Centro de Uberlândia" },
] as const;

const services = SERVICES;

const conditions = [
	"Dor lombar e cervical",
	"Hérnia de disco",
	"Pós-operatório ortopédico",
	"Lesões esportivas",
	"Postura e mobilidade",
	"Equilíbrio na terceira idade",
	"Condicionamento físico",
	"Tensão muscular e estresse",
];

const steps = [
	{ icon: "chat", title: "Chame no WhatsApp", text: "Conte o que você sente e escolha o melhor horário." },
	{ icon: "clipboard", title: "Avaliação individual", text: "Histórico, postura e movimento analisados com calma." },
	{ icon: "trend", title: "Plano sob medida", text: "Exercícios ajustados à sua evolução, aula a aula." },
] as const;
---

<Layout title="Fisioterapia e Pilates em Uberlândia | Dr. Pedro Paulo Molinar" jsonLd={homeSchema}>
	<link slot="head" rel="preload" as="image" href="/media/pilates-cadillac.webp" type="image/webp" />

	<Nav />
	<Header />

	<main>
		<!-- Trust strip -->
		<section class="border-b border-slate-200 bg-white" aria-label="Diferenciais">
			<ul class="mx-auto grid max-w-6xl grid-cols-2 gap-4 px-4 py-6 sm:px-6 md:flex md:justify-between lg:px-8">
				{trust.map((item) => (
					<li class="flex items-center gap-2 text-sm font-medium text-slate-700">
						<UiIcon name={item.icon} class="h-5 w-5 flex-none text-primary" />
						{item.label}
					</li>
				))}
			</ul>
		</section>

		<!-- Services -->
		<section id="servicos" class="py-20 lg:py-28" aria-labelledby="servicos-titulo">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="mx-auto mb-12 max-w-2xl text-center">
					<p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">Tratamentos</p>
					<h2 id="servicos-titulo" class="font-display text-3xl font-semibold text-sweetblack lg:text-4xl">Como posso te ajudar</h2>
					<p class="mt-3 text-slate-600">Cada tratamento começa por uma avaliação e é pensado para o seu corpo, sua rotina e seus objetivos.</p>
				</div>

				<div class="flex flex-wrap justify-center gap-6">
					{services.map((s) => (
						<a href={`/${s.slug}`} class="group flex w-full flex-col rounded-3xl sm:w-[calc(50%-0.75rem)] lg:w-[calc((100%-3rem)/3)] bg-white p-8 shadow-sm ring-1 ring-slate-200/70 transition hover:-translate-y-1 hover:shadow-lg">
							<div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-primary-light text-primary">
								<UiIcon name={s.icon} class="h-6 w-6" />
							</div>
							<h3 class="mb-2 text-lg font-bold text-sweetblack">{s.name}</h3>
							<p class="flex-1 text-sm leading-relaxed text-slate-600">{s.summary}</p>
							<span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary">
								Saiba mais
								<UiIcon name="chevronRight" class="h-4 w-4 transition group-hover:translate-x-1" />
							</span>
						</a>
					))}
				</div>

				<div class="mt-12 text-center">
					<h3 class="mb-4 text-sm font-semibold text-slate-600">Indicado para</h3>
					<ul class="flex flex-wrap justify-center gap-2.5">
						{conditions.map((c) => (
							<li class="rounded-full bg-white px-4 py-2 text-sm font-medium text-slate-700 ring-1 ring-slate-200">{c}</li>
						))}
					</ul>
				</div>
			</div>
		</section>

		<MediaGallery />

		<!-- About -->
		<section id="sobre" class="overflow-hidden py-20 lg:py-28" aria-labelledby="sobre-titulo">
			<div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 md:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:px-8">
				<div class="relative mx-auto w-full max-w-sm">
					<div class="absolute -inset-3 -rotate-3 rounded-[2rem] bg-primary-light" aria-hidden="true"></div>
					<img
						src="/media/pedro-paulo-molinar-fisioterapeuta.webp"
						alt="Dr. Pedro Paulo Molinar, fisioterapeuta formado pela UFU"
						width="480"
						height="480"
						loading="lazy"
						decoding="async"
						class="relative aspect-square w-full rounded-[2rem] object-cover shadow-xl"
					/>
				</div>
				<div>
					<p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">Sobre</p>
					<h2 id="sobre-titulo" class="font-display text-3xl font-semibold text-sweetblack lg:text-4xl">Dr. Pedro Paulo Molinar</h2>
					<p class="mt-2 font-medium text-primary">Fisioterapeuta formado pela Universidade Federal de Uberlândia (UFU)</p>
					<div class="mt-6 space-y-4 leading-relaxed text-slate-600">
						<p>
							Meu trabalho une fisioterapia e Pilates clínico para tratar a causa das dores — e não apenas os sintomas. Cada paciente passa por uma avaliação individual e recebe um plano pensado para o seu corpo, sua rotina e seus objetivos.
						</p>
						<p>
							No estúdio, no Centro de Uberlândia, atendo desde quem está se recuperando de uma lesão ou cirurgia até quem busca mais força, mobilidade e qualidade de vida — de jovens atletas a pessoas da terceira idade. Também ofereço massoterapia, em sessões avulsas ou para relaxar depois do treino.
						</p>
					</div>
					<a
						href={WHATSAPP_URL}
						target="_blank"
						rel="noopener noreferrer"
						data-placement="about"
						class="mt-8 inline-flex items-center gap-3 rounded-full bg-primary px-7 py-3.5 font-semibold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-primary-dark"
					>
						<UiIcon name="whatsapp" class="h-5 w-5" />
						Converse comigo
					</a>
				</div>
			</div>
		</section>

		<Testimonials />

		<!-- How it works -->
		<section class="py-20 lg:py-24" aria-labelledby="como-funciona-titulo">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div class="mx-auto mb-12 max-w-2xl text-center">
					<p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">Primeiros passos</p>
					<h2 id="como-funciona-titulo" class="font-display text-3xl font-semibold text-sweetblack lg:text-4xl">Como começar</h2>
				</div>
				<ol class="grid gap-6 md:grid-cols-3">
					{steps.map((step, i) => (
						<li class="relative rounded-3xl bg-white p-8 ring-1 ring-slate-200/70">
							<span class="absolute right-6 top-5 font-display text-5xl font-semibold text-primary-light">{i + 1}</span>
							<UiIcon name={step.icon} class="mb-4 h-8 w-8 text-primary" />
							<h3 class="mb-1 text-lg font-bold text-sweetblack">{step.title}</h3>
							<p class="text-sm text-slate-600">{step.text}</p>
						</li>
					))}
				</ol>
			</div>
		</section>

		<!-- Location -->
		<section id="contato" class="bg-white py-20 lg:py-28" aria-labelledby="contato-titulo">
			<div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
				<div>
					<p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">Contato</p>
					<h2 id="contato-titulo" class="font-display text-3xl font-semibold text-sweetblack lg:text-4xl">Localização e horários</h2>

					<dl class="mt-8 space-y-6">
						<div class="flex gap-4">
							<dt class="flex h-11 w-11 flex-none items-center justify-center rounded-2xl bg-primary-light text-primary">
								<UiIcon name="pin" />
								<span class="sr-only">Endereço</span>
							</dt>
							<dd class="text-slate-600">
								<p class="font-semibold text-sweetblack">{ADDRESS.street} – {ADDRESS.district}</p>
								<p>{ADDRESS.city} – {ADDRESS.region}, {ADDRESS.postalCode}</p>
							</dd>
						</div>
						<div class="flex gap-4">
							<dt class="flex h-11 w-11 flex-none items-center justify-center rounded-2xl bg-primary-light text-primary">
								<UiIcon name="clock" />
								<span class="sr-only">Horário de atendimento</span>
							</dt>
							<dd class="text-slate-600">
								{HOURS.map((h) => <p><span class="font-semibold text-sweetblack">{h.label}:</span> {h.time}</p>)}
							</dd>
						</div>
						<div class="flex gap-4">
							<dt class="flex h-11 w-11 flex-none items-center justify-center rounded-2xl bg-primary-light text-primary">
								<UiIcon name="card" />
								<span class="sr-only">Formas de atendimento</span>
							</dt>
							<dd class="text-slate-600">
								<p class="font-semibold text-sweetblack">Atendimento particular</p>
								<p>Gympass / Wellhub – plano Silver</p>
							</dd>
						</div>
					</dl>

					<div class="mt-10 flex flex-col gap-4">
						{links.map((link) => (
							<Link icon={link.frontmatter.icon} title={link.frontmatter.title} href={link.frontmatter.href} />
						))}
					</div>
				</div>

				<div class="flex flex-col gap-4">
					<div class="relative min-h-[360px] flex-1 overflow-hidden rounded-3xl bg-slate-100 ring-1 ring-slate-200">
						<iframe
							src={MAPS_EMBED_URL}
							title="Mapa: Molinar Fisioterapia, Av. Cesário Alvim, 521, Uberlândia"
							class="absolute inset-0 h-full w-full border-0"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
					<a
						href={MAPS_URL}
						target="_blank"
						rel="noopener noreferrer"
						data-placement="contact"
						class="inline-flex items-center justify-center gap-2 rounded-full bg-primary-light px-6 py-3 text-sm font-semibold text-primary transition hover:brightness-95"
					>
						<UiIcon name="map" class="h-4 w-4" />
						Como chegar
					</a>
				</div>
			</div>
		</section>

		<Faq items={FAQ} />

		<FinalCta href={WHATSAPP_URL} />
	</main>

	<Footer tagline={TAGLINE} />

	<FloatingWhatsApp href={WHATSAPP_URL} />
</Layout>
