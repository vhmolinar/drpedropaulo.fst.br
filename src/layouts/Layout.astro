---
import { SITE_URL, TITLE, GEO } from "../config";

export interface Props {
	title: string;
	description?: string;
	path?: string;
	noindex?: boolean;
	jsonLd?: object;
}

const {
	title,
	description = "Fisioterapeuta em Uberlândia: fisioterapia ortopédica, Pilates clínico e massoterapia no Centro, com Dr. Pedro Paulo Molinar (UFU). Particular e Gympass.",
	path = "/",
	noindex = false,
	jsonLd,
} = Astro.props;

const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/avatar-whatsapp.jpg`;
---

<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#ecf4ee" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/avatar-whatsapp.jpg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content="fisioterapeuta uberlândia, fisioterapia uberlândia, pilates uberlândia, pilates clínico uberlândia, reabilitação funcional uberlândia, fisioterapia ortopédica, pilates gympass uberlândia, massoterapia uberlândia, massagem uberlândia, pedro paulo molinar, molinar fisioterapia" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		<meta name="author" content={TITLE} />
		<link rel="canonical" href={canonical} />

		<!-- Local SEO -->
		<meta name="geo.region" content="BR-MG" />
		<meta name="geo.placename" content="Uberlândia" />
		<meta name="geo.position" content={`${GEO.lat};${GEO.lng}`} />
		<meta name="ICBM" content={`${GEO.lat}, ${GEO.lng}`} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content={TITLE} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="640" />
		<meta property="og:image:height" content="640" />
		<meta property="og:image:alt" content="Dr. Pedro Paulo Molinar, fisioterapeuta em Uberlândia" />
		<meta property="og:locale" content="pt_BR" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Bing Verification -->
		<meta name="msvalidate.01" content="267107383D9B3EECFB2E656246BCA0E3" />

		<!-- Google Analytics -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'AW-11167286553');
			(function () {
				var loaded = false;
				function load() {
					if (loaded) return;
					loaded = true;
					var s = document.createElement('script');
					s.async = true;
					s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-11167286553';
					document.head.appendChild(s);
				}
				['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (type) {
					window.addEventListener(type, load, { once: true, passive: true });
				});
				window.addEventListener('load', function () {
					setTimeout(load, 5000);
				});
			})();
			document.addEventListener('click', function (e) {
				var a = e.target.closest && e.target.closest('a[href]');
				if (!a) return;
				var channel = a.href.indexOf('wa.me') > -1 ? 'whatsapp' : a.href.indexOf('instagram.com') > -1 ? 'instagram' : a.href.indexOf('maps') > -1 ? 'maps' : null;
				if (channel) gtag('event', 'contact_click', { channel: channel, placement: a.dataset.placement || 'unknown' });
			});
		</script>

		<!-- Fonts -->
		<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/fraunces-600.woff2" as="font" type="font/woff2" crossorigin />

		<slot name="head" />

		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="bg-sand text-slate-800 antialiased">
		<slot />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Inter';
		font-style: normal;
		font-weight: 400 800;
		font-display: swap;
		src: url('/fonts/inter-latin.woff2') format('woff2');
	}
	@font-face {
		font-family: 'Fraunces';
		font-style: normal;
		font-weight: 600;
		font-display: swap;
		src: url('/fonts/fraunces-600.woff2') format('woff2');
	}
	@font-face {
		font-family: 'Fraunces';
		font-style: italic;
		font-weight: 500;
		font-display: swap;
		src: url('/fonts/fraunces-500-italic.woff2') format('woff2');
	}
	html {
		font-family: 'Inter', system-ui, sans-serif;
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
		-webkit-font-smoothing: antialiased;
	}
	body {
		margin: 0;
	}
	.no-scrollbar {
		scrollbar-width: none;
	}
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		*, *::before, *::after {
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
		}
	}
</style>
