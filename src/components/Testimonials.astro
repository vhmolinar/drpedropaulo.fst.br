---
const testimonials = [
	{
		name: "Maria Silva",
		role: "Paciente de Pilates",
		content: "Comecei o tratamento com dores na coluna e em poucas semanas já senti uma melhora significativa. O atendimento personalizado faz toda a diferença!",
		rating: 5
	},
	{
		name: "João Santos",
		role: "Reabilitação Pós-Cirúrgica",
		content: "Profissional extremamente competente e atencioso. Me ajudou muito na recuperação após a cirurgia no joelho. Recomendo demais!",
		rating: 5
	},
	{
		name: "Ana Paula Costa",
		role: "Treinamento Funcional",
		content: "Ambiente acolhedor e equipado. Os exercícios são sempre adaptados às minhas necessidades. Melhorei muito meu condicionamento físico!",
		rating: 5
	},
	{
		name: "Carlos Eduardo",
		role: "Massagem Terapêutica",
		content: "Excelente profissional! As sessões de massagem aliviaram completamente minhas tensões musculares. Saio sempre renovado de cada sessão.",
		rating: 5
	}
];
---

<section id="depoimentos" class="py-16 lg:py-24 bg-gray-50">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<h2 class="text-3xl font-bold tracking-tight text-black sm:text-4xl">
				O Que Dizem Nossos Pacientes
			</h2>
			<p class="mt-4 text-lg text-black/70 max-w-2xl mx-auto">
				Depoimentos reais de quem confia no nosso trabalho
			</p>
		</div>

		<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
			{testimonials.map((testimonial) => (
				<div class="rounded-2xl bg-white p-8 shadow-lg">
					<div class="flex gap-1 mb-4">
						{[...Array(testimonial.rating)].map(() => (
							<svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
								<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
							</svg>
						))}
					</div>
					<p class="text-black/80 italic leading-relaxed mb-6">
						"{testimonial.content}"
					</p>
					<div class="border-t border-gray-200 pt-4">
						<p class="font-semibold text-black">{testimonial.name}</p>
						<p class="text-sm text-black/60">{testimonial.role}</p>
					</div>
				</div>
			))}
		</div>

		<div class="mt-12 text-center">
			<a
				href="https://wa.me/5534984143510?text=Olá!%20Gostaria%20de%20agendar%20uma%20consulta."
				target="_blank"
				rel="noopener noreferrer"
				class="inline-block rounded-lg bg-black px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:bg-black/90"
			>
				Agende Sua Consulta
			</a>
		</div>
	</div>
</section>
