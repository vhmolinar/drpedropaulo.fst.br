---
const whatsappNumber = "5534984143510";
const whatsappMessage = encodeURIComponent("Olá! Gostaria de agendar uma consulta.");
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section id="hero" class="relative bg-primary py-20 lg:py-32">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-4xl text-center">
			<!-- Logo -->
			<div class="mb-8 flex justify-center">
				<img
					src="/logo.jpg"
					alt="Dr. Pedro Paulo Molinar Logo"
					class="h-24 w-24 rounded-full object-cover shadow-xl ring-4 ring-white/20 lg:h-32 lg:w-32"
				/>
			</div>

			<h1 class="text-4xl font-bold tracking-tight text-black sm:text-5xl lg:text-6xl">
				Pilates e Reabilitação personalizada em Uberlândia
			</h1>
			<p class="mt-6 text-lg leading-8 text-black/80 sm:text-xl">
				Atendimento individualizado com fisioterapeuta formado pela Universidade Federal de Uberlândia.
				Cuide da sua saúde com quem entende do assunto.
			</p>
			<div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<a
					href={whatsappLink}
					target="_blank"
					rel="noopener noreferrer"
					class="w-full sm:w-auto rounded-lg bg-black px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:bg-black/90 hover:shadow-xl"
				>
					Agendar Consulta
				</a>
				<a
					href="#servicos"
					class="w-full sm:w-auto rounded-lg border-2 border-black bg-transparent px-8 py-4 text-lg font-semibold text-black transition-all hover:bg-black hover:text-white"
				>
					Conheça Nossos Serviços
				</a>
			</div>
		</div>
	</div>
</section>
