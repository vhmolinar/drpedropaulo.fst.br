---
import UiIcon from "./UiIcon.astro";

export interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	data-placement="floating"
	class="fixed bottom-5 right-5 z-30 flex h-14 w-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-xl shadow-black/25 transition hover:scale-105 hover:bg-whatsapp-dark"
	aria-label="Agendar pelo WhatsApp"
>
	<UiIcon name="whatsapp" class="h-7 w-7" />
</a>
