---
export interface Props {
	title: string;
	tagline: string;
}

const { title, tagline } = Astro.props;
const year = new Date().getFullYear();
---

<footer style="background: #0f172a;">
	<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
		<div class="flex flex-col items-center gap-4 text-center">
			<div class="flex items-center gap-3">
				<img src="fisioterapia.png" class="w-8 h-8 opacity-70" alt="Fisioterapia ícone" />
				<span class="font-semibold" style="color: #94a3b8;">{title}</span>
			</div>
			<p class="text-sm" style="color: #64748b;">{tagline}</p>
			<p class="text-xs" style="color: #475569;">
				&copy; {year} {title}. Todos os direitos reservados.
			</p>
		</div>
	</div>
</footer>
