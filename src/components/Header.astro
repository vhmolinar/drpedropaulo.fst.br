---
import UiIcon from "./UiIcon.astro";
import reviews from "../data/reviews.json";
import { MEDIA } from "../data/media";
import { INSTAGRAM_URL, SUBTITLE, WHATSAPP_URL } from "../config";

const rating = reviews.rating.toLocaleString("pt-BR", { minimumFractionDigits: 1 });
const reel = MEDIA.filter((m) => m.type === "video");
---

<header id="topo" class="relative overflow-hidden bg-hero-bg">
	<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_#a7d6b7_0%,_transparent_55%)] opacity-40" aria-hidden="true"></div>
	<div class="absolute -bottom-24 -left-24 h-72 w-72 rounded-full bg-hero-glow/20 blur-3xl" aria-hidden="true"></div>

	<div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-16 pt-28 sm:px-6 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:px-8 lg:pb-24 lg:pt-36">
		<div class="text-center lg:text-left">
			<a
				href={reviews.url}
				target="_blank"
				rel="noopener noreferrer"
				data-placement="hero-rating"
				class="mb-6 inline-flex items-center gap-2 rounded-full bg-hero-fg/10 px-4 py-1.5 text-sm text-hero-fg ring-1 ring-hero-fg/20 backdrop-blur transition hover:bg-hero-fg/15"
			>
				<span class="flex text-accent">
					{[1, 2, 3, 4, 5].map(() => <UiIcon name="star" class="h-4 w-4" />)}
				</span>
				<span><strong>{rating}</strong> · {reviews.total} avaliações no Google</span>
			</a>

			<h1 class="font-display text-4xl font-semibold leading-[1.1] text-hero-fg sm:text-5xl lg:text-6xl">
				<span class="mb-3 block font-sans text-base font-semibold uppercase tracking-[0.2em] text-hero-accent sm:text-lg">Dr. Pedro Paulo Molinar</span>
				Fisioterapia e Pilates clínico em <em class="text-hero-accent">Uberlândia</em>
			</h1>

			<p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-hero-muted lg:mx-0">
				Tratamento individualizado para aliviar dores, recuperar movimentos e ganhar qualidade de vida — com avaliação e acompanhamento fisioterapêutico.
			</p>
			<p class="mt-3 text-sm font-medium text-hero-accent">{SUBTITLE}</p>

			<div class="mt-9 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
				<a
					href={WHATSAPP_URL}
					target="_blank"
					rel="noopener noreferrer"
					data-placement="hero"
					class="inline-flex w-full items-center justify-center gap-3 rounded-full bg-cta px-8 py-4 font-semibold text-cta-fg shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-cta-hover sm:w-auto"
				>
					<UiIcon name="whatsapp" class="h-5 w-5 text-cta-icon" />
					Agendar avaliação
				</a>
				<a
					href={INSTAGRAM_URL}
					target="_blank"
					rel="noopener noreferrer"
					data-placement="hero"
					class="inline-flex w-full items-center justify-center gap-3 rounded-full px-8 py-4 font-semibold text-hero-fg ring-2 ring-hero-fg/40 transition hover:-translate-y-0.5 hover:bg-hero-fg/10 sm:w-auto"
				>
					<UiIcon name="instagram" class="h-5 w-5" />
					Ver no Instagram
				</a>
			</div>
		</div>

		<div class="relative mx-auto w-full max-w-[300px] sm:max-w-[340px]">
			<div class="absolute -inset-4 rotate-3 rounded-[2.5rem] bg-hero-accent/20" aria-hidden="true"></div>
			<div class="relative aspect-[9/16] overflow-hidden rounded-[2rem] bg-primary-dark shadow-2xl ring-1 ring-white/15" data-hero-reel>
				{reel.map((video, i) => (
					<video
						class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-1000 data-[active=true]:opacity-60"
						src={video.src}
						poster={video.poster}
						width={video.width}
						height={video.height}
						muted
						playsinline
						preload={i === 0 ? "auto" : "none"}
						aria-label={video.description}
						data-active={String(i === 0)}
					></video>
				))}
				<div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-primary-dark/60 via-transparent to-primary-dark/30" aria-hidden="true"></div>
				<div class="absolute inset-x-4 top-4 flex gap-1.5" aria-hidden="true">
					{reel.map(() => (
						<span class="h-0.5 flex-1 overflow-hidden rounded-full bg-white/25">
							<span class="block h-full w-0 bg-white/80 transition-[width] duration-300 ease-linear" data-bar></span>
						</span>
					))}
				</div>
			</div>

			<div class="absolute -left-6 bottom-10 hidden items-center gap-3 rounded-2xl bg-white px-4 py-3 shadow-xl sm:flex">
				<UiIcon name="google" class="h-7 w-7" />
				<div class="text-left leading-tight">
					<p class="text-sm font-bold text-sweetblack">{rating} <span class="text-accent">★★★★★</span></p>
					<p class="text-xs text-slate-500">{reviews.total} avaliações</p>
				</div>
			</div>
			<div class="absolute -right-4 top-10 hidden rounded-2xl bg-white px-4 py-3 text-left shadow-xl sm:block">
				<p class="text-xs text-slate-500">Aceitamos</p>
				<p class="text-sm font-bold text-sweetblack">Gympass · Silver</p>
			</div>
		</div>
	</div>
</header>

<script>
	const MAX_SECONDS = 8;
	const reel = document.querySelector<HTMLElement>("[data-hero-reel]");

	if (reel && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const videos = Array.from(reel.querySelectorAll("video"));
		const bars = Array.from(reel.querySelectorAll<HTMLElement>("[data-bar]"));
		const limit = (v: HTMLVideoElement) => Math.min(v.duration || MAX_SECONDS, MAX_SECONDS);
		let current = 0;

		const show = (next: number) => {
			videos[current].pause();
			videos[current].dataset.active = "false";
			bars.forEach((bar, k) => (bar.style.width = k < next ? "100%" : "0%"));
			current = next;
			const video = videos[current];
			video.dataset.active = "true";
			video.currentTime = 0;
			video.play().catch(() => {});
			videos[(current + 1) % videos.length].preload = "auto";
		};
		const advance = () => show((current + 1) % videos.length);

		videos.forEach((video, k) => {
			video.addEventListener("timeupdate", () => {
				if (k !== current) return;
				bars[k].style.width = `${Math.min(video.currentTime / limit(video), 1) * 100}%`;
				if (video.currentTime >= limit(video) - 0.05) advance();
			});
			video.addEventListener("ended", () => k === current && advance());
		});

		videos[0].play().catch(() => {});
	}
</script>
